--[[
	This file describes all of the lighting in One Shot's archery range

	It is built by Tools/LightingBuilder into a binary file (data/Lighting/scene.lighting)
	that the Graphics system loads at startup; the game code never touches it.
	Edit a value, build BuildOneShotGameAssets (or the whole solution), and run the game to see the change.

	Coordinates are in the engine's world space (meters):
		* +x is right, +y is up, and the arrow flies down -z
		* The archer is at the shooting line (z = 0) and the target is 70 m away at z = -70

	The time of day is mid-morning, when outdoor archery competitions are usually shot:
	the sun is fairly low (about 30 degrees above the horizon) and slightly warm,
	and the sky light is a clear blue.

	IMPORTANT: The sun's direction is also baked into the static meshes' vertex colors as shadows
	(OneShotGame_/Content/Blender/build_archery_range.py, SUN_DIRECTION).
	If "directional.direction" is changed here, change it there too and rebuild the meshes,
	or the baked shadows will point a different way than the lighting.

	Every section and every value is optional: anything that is left out uses the default in Engine/Lighting/sLightingData.h.
	Colors are { r, g, b } with each channel between 0 and 1; brightness is controlled separately by "intensity".
]]

return
{
	-- Ambient light stands in for all of the light bouncing around the scene:
	-- surfaces facing up get skyColor, surfaces facing down get groundColor (light bounced off the grass)
	ambient =
	{
		skyColor = { 0.62, 0.74, 0.92 },
		groundColor = { 0.42, 0.46, 0.30 },
		intensity = 0.55,
	},

	-- The morning sun, coming from behind the archer's left shoulder,
	-- so the target faces and the obstacles' fronts are lit and their shadows fall down the range
	directional =
	{
		direction = { 0.45, -0.5, -0.74 },
		color = { 1.0, 0.94, 0.82 },
		intensity = 1.1,
	},

	-- Mostly matte materials (grass, wood, straw, painted steel)
	specular =
	{
		intensity = 0.12,
		shininess = 24,
	},

	-- Outdoors in daylight there are no point lights
	pointLights =
	{
	},
}
